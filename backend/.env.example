# ==============================================================================
# CryptoJasoos Backend Environment Configuration
# ==============================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:3000

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cryptojasoos?retryWrites=true&w=majority
MONGODB_URI=

# Blockchain Provider Keys (Ethereum Mainnet)
# If left empty, CryptoJasoos connects to public Ethereum JSON-RPC with appropriate rate limiting.
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
DEFAULT_NETWORK=homestead

# Google Gemini API Key (Optional: for AI forensic explanation copilot)
# Obtain from: https://aistudio.google.com/
# If left empty, all rule-based risk engines function normally and the AI endpoint notes the missing key.
GEMINI_API_KEY=
